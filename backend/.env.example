# Server Port (Render dynamically injects this, default is 8080)
PORT=8080

# Firebase Project Configuration
FIREBASE_PROJECT_ID=ritgpacalc

# Option A (Recommended for Render / Cloud): Paste complete Service Account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"ritgpacalc","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# Option B (Local file path alternative):
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# CORS Configuration: Comma-separated list of allowed frontend origins or patterns
# Example: Include your Vercel deployment domain and local dev ports
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://*.vercel.app,https://your-production-app.vercel.app
